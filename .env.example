# Скопируйте в .env и задайте свои значения:  cp .env.example .env

# Пароль PostgreSQL
POSTGRES_PASSWORD=netmap-db-password

# ОБЯЗАТЕЛЬНО: два разных случайных ключа не короче 32 символов, каждый — вывод  openssl rand -hex 32
# (./demo.sh заполняет их сам). С пустыми или примерными значениями NetMap не запустится.
# Ключ подписи токенов входа:
NETMAP_SECRET_KEY=
# Ключ шифрования паролей и community устройств. НЕ МЕНЯЙТЕ после ввода учётных данных —
# иначе сохранённые секреты нельзя будет расшифровать.
NETMAP_ENCRYPTION_KEY=

# Первый администратор (создаётся при первом запуске, пароль сменить после входа)
NETMAP_ADMIN_USERNAME=admin
NETMAP_ADMIN_PASSWORD=admin

# Срок токена входа, минут (интерфейс продлевает его, пока вы работаете)
NETMAP_ACCESS_TOKEN_MINUTES=30
# Наибольшая длительность сессии, часов: потом нужен пароль, даже если вы всё время работали
NETMAP_SESSION_MAX_HOURS=12

# Порт веб-интерфейса на хосте
NETMAP_HTTP_PORT=8080

# Адрес интерфейса для ссылок в сообщениях Telegram
NETMAP_PUBLIC_URL=http://localhost:8080

# Защита входа (значения по умолчанию)
# NETMAP_LOGIN_MAX_ATTEMPTS=5          # неверных паролей подряд до блокировки учётной записи
# NETMAP_LOGIN_LOCK_MINUTES=15
# NETMAP_LOGIN_IP_MAX_ATTEMPTS=20      # неудачных входов с одного IP за окно
# NETMAP_LOGIN_IP_WINDOW_MINUTES=15
# NETMAP_PASSWORD_MIN_LENGTH=8
# NETMAP_SESSION_IDLE_MINUTES=30       # выход после бездействия (0 — не выходить)

# Описание API на /api/docs (видно без входа, поэтому выключено)
# NETMAP_API_DOCS=true
# Другие адреса, с которых браузер может обращаться к API (через запятую); пусто — только свой адрес
# NETMAP_CORS_ORIGINS=
